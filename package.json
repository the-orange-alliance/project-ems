{
  "name": "ems",
  "private": true,
  "author": {
    "email": "kyleflynn.dev@gmail.com",
    "name": "Kyle Flynn",
    "url": "https://github.com/kyle-flynn"
  },
  "scripts": {
    "build:libs": "turbo run @toa-lib/client#build @toa-lib/server#build",
    "build": "turbo build",
    "build:apps": "turbo run api#build realtime#build ems-web#build",
    "check-types": "turbo check-types",
    "dev": "turbo run dev api#start realtime#dev"
  },
  "repository": {
    "url": "https://github.com/the-orange-alliance/project-ems.git"
  },
  "devDependencies": {
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "libs/models",
    "libs/client",
    "libs/server",
    "apps/services/api",
    "apps/services/realtime",
    "apps/services/frc-fms",
    "apps/web"
  ],
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "engine": {
    "node": ">=20.0.0"
  },
  "packageExtensions": {
    "promised-sqlite3@2.1.0": {
      "peerDependencies": {
        "sqlite3": "^5 || ^6"
      }
    }
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "bufferutil@4.1.0": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true,
    "utf-8-validate@6.0.6": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
